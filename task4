    opt_d1 = torch.optim.Adam(decoder_no_att.parameters(), lr=LR)
    crit = nn.CrossEntropyLoss(ignore_index=PAD_ID)
    for ep in range(EPOCHS):
        train_epoch(encoder_no_att, decoder_no_att, tloader, opt_e1, opt_d1, crit, ep, EPOCHS, use_att=False)
        evaluate(encoder_no_att, decoder_no_att, vloader, crit, ep, EPOCHS, use_att=False)
    bleu_no_att = calc_bleu(encoder_no_att, decoder_no_att, teloader, sp, use_att=False)
    print(f"Test BLEU without Attention: {bleu_no_att:.2f}")

    print("\nTraining WITH Attention Model ...")
    encoder_att = Encoder(VOCAB_SIZE, EMB_DIM, HID_DIM, None).to(device)
    decoder_att = AttnDecoder(VOCAB_SIZE, EMB_DIM, HID_DIM, None).to(device)
    opt_e2 = torch.optim.Adam(encoder_att.parameters(), lr=LR)
    opt_d2 = torch.optim.Adam(decoder_att.parameters(), lr=LR)
    for ep in range(EPOCHS):
        train_epoch(encoder_att, decoder_att, tloader, opt_e2, opt_d2, crit, ep, EPOCHS, use_att=True)
        evaluate(encoder_att, decoder_att, vloader, crit, ep, EPOCHS, use_att=True)
    bleu_att = calc_bleu(encoder_att, decoder_att, teloader, sp, use_att=True)
    print(f"Test BLEU with Attention: {bleu_att:.2f}")

    print("\nVisualizing Attention on a test example ...")
    visualize_one_example_attention(encoder_att, decoder_att, teloader, sp, use_att=True, idx=0)
